#!/usr/bin/make -f
# SPDX-License-Identifier: MIT
# SPDX-FileCopyrightText: 2026 Nelson Pascoal
#
# The package is one tree: install.sh --mode system is the same install path the
# Makefile exposes, so a dpkg build and a manual install cannot drift apart.

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

override_dh_auto_build:
	$(MAKE) native
	# The stamp is written by the same code that reads it (mwl.write_stamp), so the
	# packaged artifact is provably current with no digest logic duplicated here.
	PYTHONPATH=$(CURDIR) /usr/bin/python3 -c "from pathlib import Path; from matrix_overlay import mwl; n = Path('$(CURDIR)/native'); mwl.write_stamp(n, n / 'libmwl.so')"; ls -l $(CURDIR)/native/libmwl.so.stamp

override_dh_auto_install:
	sh install.sh --mode system --destdir '$(CURDIR)/debian/matrix-overlay'

# No override_dh_auto_test on purpose. There used to be one that ran the suite
# only if pytest, gi and cairo happened to be importable, and printed "skipped"
# otherwise: in a clean build chroot that meant the artifact the archive builds
# was never tested, quietly. The suite now runs as the `unit` autopkgtest with
# `Restrictions: build-needed`, where the dependencies are declared and the
# result is reported by debci instead of swallowed by a build log.
