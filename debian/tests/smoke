#!/bin/sh
# The installed package, exercised the way a user's session would find it, but
# without ever drawing on a screen: a layer-shell surface in CI is a race with
# whatever compositor happens to be there, and this app's whole purpose is a
# surface nobody can assert on headlessly. Everything here is a claim about the
# files and the command's own contract.
set -eu

# An `Autopkgtest: @` entry runs from the top of the *source* tree, and
# `python -m matrix_overlay` puts the working directory on sys.path: without this
# cd, the entry exercises the source copy while claiming to test the installed
# package. (It did - the preflight line named the build directory.)
# AUTOPKGTEST_TMP is autopkgtest's scratch directory; the older adt-run variable
# of the same purpose is deliberately not spelled out here, because lintian warns
# on any mention of it, comment included. The mktemp fallback keeps this entry
# runnable by hand. Either way, the directory is outside the source tree.
cd "${AUTOPKGTEST_TMP:-$(mktemp -d)}"

command -v matrix-rain
matrix-rain --help >/dev/null
matrix-rain --version | grep -q '^matrix-rain [0-9]'
matrix-rain --print-default-config | grep -q '^\[world\]'

# The packaged modules must import in a headless testbed: that is where a
# missing typelib or an unloadable .so shows up as a packaging defect. What
# --preflight also answers - "can a show start *here*?" - is a property of this
# environment, not of the package: in a container with no compositor and no
# /dev/dri it legitimately returns 3 (no layer shell). Asserting 0 there would
# be a test that only passes on a desktop.
PYTHONPATH=/usr/lib/matrix-overlay /usr/bin/python3 -c \
  'import matrix_overlay, matrix_overlay.cli, matrix_overlay.app, matrix_overlay.glsurface, matrix_overlay.mwl
print("imported from", matrix_overlay.__file__)
assert matrix_overlay.__file__.startswith("/usr/lib/matrix-overlay/"), matrix_overlay.__file__
print("imports ok")'
matrix-rain --preflight || {
  rc=$?
  [ "$rc" -eq 3 ] || { echo "smoke: --preflight failed with $rc" >&2; exit "$rc"; }
  echo "smoke: no compositor in this testbed (preflight 3), as expected in CI"
}

# Placement the .desktop file, the icon theme and AppStream all depend on.
test -f /usr/lib/matrix-overlay/matrix_overlay/app.py
test -f /usr/lib/matrix-overlay/native/libmwl.so
test -f /usr/share/metainfo/tech.i2r.matrixoverlay.metainfo.xml
test -f /usr/share/applications/tech.i2r.matrixoverlay.desktop
test -f /usr/share/icons/hicolor/scalable/apps/tech.i2r.matrixoverlay.svg
test -f /etc/matrix-overlay/config.toml
test -f /usr/share/man/man1/matrix-rain.1.gz

# Hardening that a C client loaded into a graphical session must keep. (There is
# no `readelf -m`: an invalid option prints a usage block, and the grep under it
# fails with a confusing exit 1 - found the hard way in CI.)
readelf -lW /usr/lib/matrix-overlay/native/libmwl.so | grep -q 'GNU_STACK.*RW '
readelf -lW /usr/lib/matrix-overlay/native/libmwl.so | grep -q 'GNU_RELRO'
readelf -dW /usr/lib/matrix-overlay/native/libmwl.so | grep -q 'BIND_NOW'

echo "smoke: ok"
