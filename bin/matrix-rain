#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# SPDX-FileCopyrightText: 2026 Nelson Pascoal
# matrix-rain - thin shim for the COSMIC custom shortcut (Ctrl+Shift+M).
#
# Responsibilities, and only these (plan D1.6):
#   * pin the interpreter: PATH python3 is an asdf shim on 3.14 with no `gi` (T9)
#   * keep GI_TYPELIB_PATH clean so no other tool's typelibs leak in (T14)
#   * preflight, then exec the app
# Everything else - lock/toggle, escalation ladder, env pinning, veil, rendering,
# and the *decision of which backend needs which dependencies* - lives in
# matrix_overlay.cli, where it is unit-tested.
#
# The preflight used to import GtkLayerShell unconditionally here. That is the
# cairo backend's dependency: the default GL backend is a native Wayland client
# (native/libmwl.so) and needs none of it, so on an AMD-only box without
# gir1.2-gtklayershell-0.1 the shim aborted with exit 3 before EGL was even
# tried, and the log blamed the GPU. `--preflight` answers "can any backend run
# here?" and names the missing pieces.
#
# The shortcut's Spawn() is NOT run by a shell (cosmic-settings-daemon uses
# pidfd_spawnp), so this command must be PATH-resolvable as a bare word and must
# not use $HOME, redirects, or quoting.
set -euo pipefail

# Where the app package lives. There is no way to pass environment through
# COSMIC's Spawn(), so discovery happens here: the packaged install is
# /usr/lib/matrix-overlay (a sibling of /usr/bin, where this shim lives) and the
# dotfile install is ~/.local/share/matrix-overlay (a sibling of ~/.local/bin).
# Resolving it from the shim's own location is what lets one shim serve both
# profiles, and stops the dotfile path from leaking into the .deb.
app_root() {
  local here cand
  here=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
  for cand in "${MATRIX_OVERLAY_DIR:-}" "$here/../lib/matrix-overlay" \
              "$here/../share/matrix-overlay" "$here/.." "$HOME/.local/share/matrix-overlay"; do
    if [[ -n "$cand" && -f "$cand/matrix_overlay/__main__.py" ]]; then
      CDPATH= cd -- "$cand" && pwd -P
      return 0
    fi
  done
  # Nothing found: report the dotfile path, which is what the error should name.
  printf '%s' "$HOME/.local/share/matrix-overlay"
}

APP_DIR="${MATRIX_OVERLAY_DIR:-$(app_root)}"
PYTHON="${MATRIX_OVERLAY_PYTHON:-/usr/bin/python3}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/matrix-overlay"
LOG_FILE="$STATE_DIR/matrix-rain.log"

mkdir -p "$STATE_DIR"

if [[ ! -x "$PYTHON" ]]; then
  printf 'matrix-rain: %s not executable\n' "$PYTHON" >>"$LOG_FILE" 2>&1
  exit 5
fi

unset GI_TYPELIB_PATH LD_LIBRARY_PATH
export GDK_BACKEND=wayland
export PYTHONPATH="$APP_DIR${PYTHONPATH:+:$PYTHONPATH}"

if ! "$PYTHON" -m matrix_overlay --preflight >>"$LOG_FILE" 2>&1; then
  printf '%s preflight FAILED: no usable backend (reason above)\n' \
    "$(date -Iseconds)" >>"$LOG_FILE"
  exit 3
fi

exec "$PYTHON" -m matrix_overlay "$@"
